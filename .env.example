# Example environment for the BroccoliDetect backend.
#   cp .env.example .env   then fill in the values.
# .env is git-ignored — NEVER commit real secrets. The values below are the
# defaults; every variable is read by the backend.

# --- Auth: if set, /api/detect requires this value in the X-API-Key header ---
# Leave empty to disable auth locally. The frontend forwards this same value.
API_KEY=

# --- Rate limiting (per client IP): max requests per time window in seconds ---
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Environment: "production" hides the API docs (/docs); "dev" keeps them on ---
DEPLOY_ENV=dev

# --- CORS: browser origins allowed to call the API (comma-separated) ---
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Uploaded images: delete files older than the TTL; sweep runs every N seconds ---
UPLOAD_TTL_SECONDS=3600
UPLOAD_SWEEP_SECONDS=600

# --- Logging level: DEBUG, INFO, WARNING or ERROR ---
LOG_LEVEL=INFO

# --- Model version: which entry of backend/weights/registry.json to load.
#     Changing this (plus MODEL_WEIGHTS_URL below for versions not baked into
#     the image) rolls the model forward or back without rebuilding the image.
MODEL_VERSION=v1.0.0

# --- Remote weights (optional): HTTPS URL (e.g. an Azure Blob SAS URL) the
#     backend downloads the weights from at startup when the file for
#     MODEL_VERSION is not on disk. Leave empty to use the local file only.
# MODEL_WEIGHTS_URL=

# --- Weights integrity check: SHA-256 of the weights file. Explicitly set, it
#     always wins; otherwise the hash from weights/registry.json is enforced in
#     production and for downloaded weights (dev warns and skips). The server
#     won't start on a mismatch, and production refuses to start unverified.
# EXPECTED_WEIGHTS_SHA256=bf5f8500bba6a3b52bb55aec0212eef64581bff199e0e64a9f42322bf04acf6f

# --- Start without a model (optional): set to 1 to start even if best.pt is missing ---
# ALLOW_MISSING_WEIGHTS=
