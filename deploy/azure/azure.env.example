# Azure resource names for the Makefile targets (B4 BroccoliDetect).
#
#   cp deploy/azure/azure.env.example deploy/azure/azure.env
# then fill in the values. azure.env is git-ignored — it holds names specific
# to your team/tenant, and keeping it out of the repo means the Makefile
# defaults stay generic. The Makefile loads this file automatically when it
# exists; anything you leave out falls back to the defaults in the Makefile.
#
# Course rules to respect when filling this in:
#   - RESOURCE_GROUP must be the resource group assigned to your team — you
#     cannot create your own.
#   - Resource names follow the teamXX-service-name convention.
#   - Everything is deployed in westeurope; other regions are not allowed.

# Azure Container Registry name (bare name, no .azurecr.io suffix). ACR names
# allow only lowercase alphanumerics, hence no dashes here.
ACR_NAME=teamb4broccoliacr

# The team's assigned resource group. REQUIRED: `make deploy` refuses to run
# while this is empty, to avoid az picking up some unrelated default.
RESOURCE_GROUP=

# The App Service webapp that runs the combined UI+API image (the deployed
# platform), and its plan.
WEBAPP=teamb4-broccoli-api
WEBAPP_PLAN=teamb4-broccoli-plan

# The Container App name for the alternative platform (see `make deploy-containerapp`).
CONTAINER_APP=teamb4-broccoli-api

# The Container Apps environment the app lives in. Not used by `make deploy`
# (update keeps the existing environment) but needed when creating the app
# for the first time with `az containerapp create`.
CONTAINER_ENV_NAME=teamb4-broccoli-env

# Image repository name inside ACR, and the tag to build/push/deploy.
IMAGE=broccoli-detect
TAG=latest

# Azure region — the course allows westeurope only.
LOCATION=westeurope
