# Nginx config template for the BroccoliDetect frontend container.
#
# Lives in /etc/nginx/templates/ so the official nginx:alpine image
# runs `envsubst` on it at startup and writes the result to
# /etc/nginx/conf.d/default.conf.
#
# The proxy upstream is built from three env vars set by the
# entrypoint hook (10-derive-backend-url.envsh):
#   - ${BACKEND_SCHEME}  http or https
#   - ${BACKEND_HOST}    hostname
#   - ${BACKEND_PORT}    port
#
# These get assigned to an nginx variable ($backend_upstream) which we
# then reference in proxy_pass. Using a variable forces nginx to
# resolve DNS at request time (via the `resolver` below) rather than
# at startup — so the frontend can boot before the backend is
# reachable, and a backend redeploy is picked up automatically.

# DNS resolver. Configurable so the same template works in both
# environments:
#   - docker-compose:  127.0.0.11 (Docker's embedded resolver)
#   - Render:          1.1.1.1 (Cloudflare public DNS) — we use the
#     backend's public *.onrender.com URL since Render's private DNS
#     doesn't answer raw UDP queries from nginx's resolver.
resolver ${DNS_RESOLVER} valid=30s ipv6=off;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # --- Security headers --------------------------------------------------
    # Sent on every response (the `always` flag also covers error/proxied
    # responses). Defined at server level so they are inherited by the
    # proxied /api/ and /uploads/ locations below (which add no headers of
    # their own). nginx drops inherited add_header directives in any block
    # that declares its own add_header, so the one block that does
    # (location /, for Cache-Control) repeats these.
    #   - nosniff: don't MIME-sniff; important because user-uploaded images
    #     are served same-origin via /uploads/.
    #   - DENY framing + CSP frame-ancestors: anti-clickjacking.
    #   - CSP: everything loads from 'self'. style-src allows 'unsafe-inline'
    #     for Tailwind/React inline styles; img-src allows blob:/data: for the
    #     client-side image preview (URL.createObjectURL).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;

    # --- Compression -------------------------------------------------------
    # Shrinks text assets on the wire. text/html is gzipped by default.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types
        text/plain
        text/css
        application/javascript
        application/json
        image/svg+xml;

    # --- Static asset caching ---------------------------------------------
    # Vite fingerprints these filenames (e.g. index-a1b2c3.js), so they are
    # safe to cache long-term. Uses `expires` only (no add_header) so the
    # security headers above are still inherited here. This regex location is
    # evaluated before the prefix locations, which is why /api/ and /uploads/
    # below use ^~ to keep priority (so e.g. /uploads/x.png is still proxied).
    location ~* \.(?:js|mjs|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|ico|webp)$ {
        expires 1y;
        access_log off;
        try_files $uri =404;
    }

    # React Router uses client-side routes, so any unknown URL
    # should serve index.html (the React app will handle it). The HTML shell
    # is never cached so users always pull the newest index.html (which then
    # references the freshest fingerprinted assets). This block has its own
    # add_header, so it must repeat the security headers from above.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" always;
    }

    # Forward API calls to the backend.
    # The variable in proxy_pass defers DNS resolution to request time;
    # we append $request_uri so the location prefix isn't stripped.
    # ^~ gives this prefix priority over the static-asset regex location
    # above, so API paths are always proxied and never matched as files.
    location ^~ /api/ {
        set $backend_upstream ${BACKEND_HOST}:${BACKEND_PORT};
        proxy_pass ${BACKEND_SCHEME}://$backend_upstream$request_uri;
        # Use the backend's hostname for SNI / virtual-host routing.
        proxy_set_header Host ${BACKEND_HOST};
        proxy_ssl_server_name on;
        # Inject the backend API key server-side so the browser never sees
        # it. When ${API_KEY} is empty (local dev), nginx drops the header
        # and the keyless backend ignores it.
        proxy_set_header X-API-Key "${API_KEY}";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 15M;
        # YOLO inference on Render's free tier (0.1 CPU) can take 30-60s
        # per request, especially after a cold start. Default 60s would
        # 504 even when the backend eventually returns 200.
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_connect_timeout 30s;
    }

    # Forward uploaded image requests too. ^~ keeps this prefix ahead of the
    # static-asset regex location, so e.g. /uploads/photo.png is proxied to
    # the backend rather than being looked up as a local file.
    location ^~ /uploads/ {
        set $backend_upstream ${BACKEND_HOST}:${BACKEND_PORT};
        proxy_pass ${BACKEND_SCHEME}://$backend_upstream$request_uri;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_ssl_server_name on;
    }
}
